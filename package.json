{
  "name": "around",
  "version": "0.1.0",
  "private": true,
  "description": "AROUND \u2014 Your stay is just the beginning. An AI-powered Experience Intelligence & Commerce layer for travel marketplaces (independent proof of concept).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
