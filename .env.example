# Data source: "memory" (default, zero setup) or "prisma" (PostgreSQL via Prisma)
DATA_SOURCE=memory
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/around?schema=public"

# AI provider: "mock" (default, no keys) or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments are always mocked in this MVP
PAYMENT_PROVIDER=mock
